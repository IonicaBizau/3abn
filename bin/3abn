#!/usr/bin/env node

"use strict";

const ThreeAbn = require("../lib")
    , Tilda = require("tilda")
    , Logger = require("bug-killer")
    , Diable = require("diable")
    , CliUpdate = require("cli-update")
    , CliBox = require("cli-box")
    , cliResize = require("cli-resize")
    ;

new Tilda(`${__dirname}/../package.json`, {
    options: [{
        opts: ["d", "daemon"]
      , desc: "Run in the background."
      , type: Boolean
    }]
}).main(a => {
    const daemon = a.options.daemon.value;
    if (daemon && !Diable.isDaemon()) {
        Diable();
        return setTimeout(process.exit, 1000);
    }

    const player = new ThreeAbn();
    const interactive = !daemon && process.stdin.isTTY;

    function render () {
        if (daemon) { return; }

        const width = Math.max(10, CliUpdate.columns - 4)
            , songs = player.songInfo && player.songInfo.playlist || []
            , recent = songs.slice(-Math.max(0, CliUpdate.rows - 8))
            , lines = ["3ABN Radio Music Channel", "─".repeat(width)]
            ;

        if (player.songInfo) {
            lines.push(...recent.map(song => `${song.date.format("HH:mm")}  ${song.title}`));
            lines.push("", `Now playing: ${player.songInfo.playing}`);
            if (player.liked_current_song) { lines.push("♥ Saved to favorites"); }
        } else {
            lines.push(player.is_playing ? "Playing — waiting for song information" : "Connecting...");
        }
        lines.push("", "L save song  •  Q quit");
        if (process.stdout.isTTY) {
            CliUpdate.render(CliBox({ fullscreen: true, hAlign: "left", vAlign: "bottom" }, lines.join("\n")));
        } else {
            console.log(lines.join("\n"));
        }
    }

    function quit (code = 0) {
        if (process.stdin.isRaw) { process.stdin.setRawMode(false); }
        player.stop();
        process.exit(code);
    }

    player.on("playing", render);
    player.on("song_changed", render);
    player.on("song_changed_error", err => Logger.log(err, "error"));
    player.on("error", err => { Logger.log(err, "error"); quit(1); });
    player.on("playend", () => Logger.log("Playback ended.", "warn"));

    if (interactive) {
        process.stdin.setRawMode(true);
        process.stdin.resume();
        process.stdin.setEncoding("utf8");
        process.stdin.on("data", key => {
            if (key === "\u0003" || key.toLowerCase() === "q") { quit(); }
            if (key.toLowerCase() === "l") {
                player.likeCurrentSong(err => err ? Logger.log(err, "error") : render());
            }
        });
    }

    process.on("SIGINT", () => quit());
    process.on("SIGTERM", () => quit());
    cliResize(render);
    render();
});
